{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shinden Client",
  "version": "4.0.3",
  "identifier": "com.blazejdrozd.shinden-client-rs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Shinden Client",
        "width": 900,
        "height": 700,
        "decorations": false,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32.png",
      "icons/128.png",
      "icons/256.png",
      "icons/sc4.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFQzRBOUU2QUY4NzBBMkMKUldRc0NvZXY1cW5FM2xxeWlKNHZHMGVZRzhTV2NFS21LU0VQZ0xpMnJZai90T0gwNDVwUFVGRFIK",
      "endpoints": [
        "https://github.com/NefilimPL/shinden-client/releases/latest/download/latest.json"
      ]
    }
  }
}
